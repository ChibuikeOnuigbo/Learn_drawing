# Deliverable examples are tracked, but their bulky intermediate frames are not
!examples/
!examples/**/*.mp4
!examples/**/*.blend
examples/**/frames/
examples/**/rig-frames/
examples/**/asset-*/
examples/**/caption-*.png
examples/**/clip-*.mp4
examples/**/assembled.mp4
examples/**/mixed.wav
examples/**/concat.txt
examples/**/inspection/sample-*.png
